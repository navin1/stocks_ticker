{
  "manifest_version": 3,
  "name": "Stock Ticker Dashboard",
  "version": "1.0.0",
  "description": "Live stock prices, charts, news and AI insights from Yahoo Finance",
  "action": {
    "default_title": "Open Stock Dashboard",
    "default_icon": {
      "16":  "icons/icon16.png",
      "32":  "icons/icon32.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://query1.finance.yahoo.com/*",
    "https://query2.finance.yahoo.com/*",
    "https://feeds.finance.yahoo.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "icons": {
    "16":  "icons/icon16.png",
    "32":  "icons/icon32.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
